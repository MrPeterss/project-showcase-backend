generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum CourseOfferingRole {
  INSTRUCTOR
  STUDENT
  VIEWER
}

enum EnvironmentScope {
  PRODUCTION
  DEVELOPMENT
}

model User {
  id           Int      @id @default(autoincrement())
  name         String?
  email        String   @unique
  refreshToken String?  @unique
  firebaseId   String?  @unique
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  courseOfferingEnrollments CourseOfferingEnrollment[]
  teamMemberships           TeamMembership[]
  deployedProjects          Project[]
}

model Course {
  id         Int      @id @default(autoincrement())
  name       String
  number     Int
  department String
  createdAt  DateTime @default(now())

  offerings CourseOffering[]
}

model Semester {
  id        Int      @id @default(autoincrement())
  season    String
  year      Int
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  offerings CourseOffering[]
}

model CourseOffering {
  id        Int      @id @default(autoincrement())
  settings  Json
  createdAt DateTime @default(now())

  course     Course   @relation(fields: [courseId], references: [id])
  courseId   Int
  semester   Semester @relation(fields: [semesterId], references: [id])
  semesterId Int

  enrollments         CourseOfferingEnrollment[] @relation("courseOffering")
  referredEnrollments CourseOfferingEnrollment[] @relation("referringCourseOffering")
  teams               Team[]
  offeringTags        OfferingTag[]

  @@unique([courseId, semesterId])
}

model Team {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  hallOfFame   Boolean  @default(false)
  createdAt    DateTime @default(now())

  CourseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id])
  courseOfferingId Int

  members       TeamMembership[]
  projects      Project[]
  environments  TeamEnvironment[]
}

model TeamEnvironment {
  id       Int              @id @default(autoincrement())
  teamId   Int
  keyName  String
  keyValue String
  scope    EnvironmentScope
  isSecret Boolean          @default(false)

  team Team @relation(fields: [teamId], references: [id])

  @@unique([teamId, keyName, scope])
}

model CourseOfferingEnrollment {
  id   Int                @id @default(autoincrement())
  role CourseOfferingRole

  user                    User            @relation(fields: [userId], references: [id])
  userId                  Int
  courseOffering          CourseOffering  @relation("courseOffering", fields: [courseOfferingId], references: [id])
  courseOfferingId        Int
  referringCourseOffering CourseOffering? @relation("referringCourseOffering", fields: [referringCourseId], references: [id])
  referringCourseId       Int?
}

model TeamMembership {
  user   User @relation(fields: [userId], references: [id])
  userId Int
  team   Team @relation(fields: [teamId], references: [id])
  teamId Int

  @@id([userId, teamId])
}

model Project {
  id                   Int       @id @default(autoincrement())
  githubUrl            String
  imageHash            String // Docker image ID/hash (sha256:...)
  tag                  String? // Legacy: last/mirror of tag name for compatibility; use ProjectOfferingTag
  containerId          String?   @unique
  containerName        String?
  status               String // running, stopped, failed, etc.
  ports                Json? // Store port mappings as JSON
  buildLogs            String? // Store build logs as text
  buildArgs            Json? // Store build arguments as JSON
  extraEnvVars         Json? // Store extra project-specific environment variables as JSON
  dataFile             String? // Path to uploaded data file on host
  originalDataFileName String? // Original filename of the uploaded data file
  deployedAt           DateTime  @default(now())
  stoppedAt            DateTime?
  lastCheckedAt        DateTime? // Last time we checked if a stopped project is back online
  failedCheckCount     Int       @default(0) // Number of consecutive failed checks for backoff
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  team         Team  @relation(fields: [teamId], references: [id])
  teamId       Int
  deployedBy   User? @relation(fields: [deployedById], references: [id])
  deployedById Int?

  projectOfferingTags ProjectOfferingTag[]

  @@index([status])
}

/// A named tag within a course offering (e.g. milestone-1). Replaces ad-hoc Project.tag for new data.
model OfferingTag {
  id               Int      @id @default(autoincrement())
  courseOfferingId Int
  name             String
  createdAt        DateTime @default(now())

  courseOffering CourseOffering       @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  projectLinks   ProjectOfferingTag[]

  @@unique([courseOfferingId, name])
  @@index([courseOfferingId])
}

/// Links a project deployment to one offering tag (many tags per project over time).
model ProjectOfferingTag {
  projectId     Int
  offeringTagId Int
  createdAt     DateTime @default(now())

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  offeringTag OfferingTag @relation(fields: [offeringTagId], references: [id], onDelete: Cascade)

  @@id([projectId, offeringTagId])
  @@index([offeringTagId])
}
